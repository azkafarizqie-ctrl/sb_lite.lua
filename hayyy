local function GetRefPoint()
    local cam = Workspace.CurrentCamera
    if not cam then return Vector2.zero end
    if Config.AimMode == "Crosshair" then
        local vp = cam.ViewportSize
        return Vector2.new(vp.X * 0.5, vp.Y * 0.5)
    end
    return UserInputService:GetMouseLocation()
end

local CachedTargetPart = nil
local CachedScreenPos = nil
local LastTargetScan = 0
local LastLineUpdate = 0
local Unloaded = false

local function ScanTarget(refPoint)
    local cam = Workspace.CurrentCamera
    if not cam then
        CachedTargetPart = nil
        CachedScreenPos = nil
        return
    end

    local bestPart = nil
    local bestScreen = nil
    local fovSq = Config.FOV * Config.FOV
    local list = Players:GetPlayers()

    for i = 1, #list do
        local plr = list[i]
        if plr ~= LocalPlayer then
            if not (Config.TeamCheck and plr.Team == LocalPlayer.Team) then
                local char = plr.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local part = char:FindFirstChild(Config.HitPart) or char:FindFirstChild("HumanoidRootPart")
                    if part and part:IsA("BasePart") then
                        local pos, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen and pos.Z > 0 then
                            local dx = pos.X - refPoint.X
                            local dy = pos.Y - refPoint.Y
                            local dSq = dx * dx + dy * dy
                            if dSq < fovSq then
                                fovSq = dSq
                                bestPart = part
                                bestScreen = Vector2.new(pos.X, pos.Y)
                            end
                        end
                    end
                end
            end
        end
    end

    CachedTargetPart = bestPart
    CachedScreenPos = bestScreen
end

local RenderConn = RunService.RenderStepped:Connect(function()
    if Unloaded then return end

    if not Config.Enabled then
        CachedTargetPart = nil
        CachedScreenPos = nil
        if FOVCircle then FOVCircle.Visible = false end
        if TargetLine then TargetLine.Visible = false end
        return
    end

    local now = os.clock()
    local ref = GetRefPoint()

    if (now - LastTargetScan) >= Config.TargetScanRate then
        LastTargetScan = now
        ScanTarget(ref)
    end

    if FOVCircle then
        FOVCircle.Position = ref
        FOVCircle.Radius = Config.FOV
        FOVCircle.Visible = Config.ShowFOV
    end

    if (now - LastLineUpdate) >= Config.LineUpdateRate then
        LastLineUpdate = now
        if TargetLine and Config.ShowLine and CachedTargetPart then
            local cam = Workspace.CurrentCamera
            if cam and CachedTargetPart.Parent then
                local p, vis = cam:WorldToViewportPoint(CachedTargetPart.Position)
                if vis and p.Z > 0 then
                    TargetLine.From = ref
                    TargetLine.To = Vector2.new(p.X, p.Y)
                    TargetLine.Visible = true
                else
                    TargetLine.Visible = false
                end
            else
                TargetLine.Visible = false
            end
        elseif TargetLine then
            TargetLine.Visible = false
        end
    end
end)

if not getgenv().OllieSB_V2_Hooked then
    getgenv().OllieSB_V2_Hooked = true
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        if checkcaller() or Unloaded or not Config.Enabled or not CachedTargetPart then
            return oldNamecall(self, ...)
        end

        if self == Workspace then
            local method = getnamecallmethod()
            if method == "Raycast" then
                local args = {...}
                local origin = args[1]
                if typeof(origin) == "Vector3" then
                    args[2] = (CachedTargetPart.Position - origin).Unit * 1000
                    return oldNamecall(self, unpack(args))
                end
            elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" then
                local args = {...}
                local ray = args[1]
                if typeof(ray) == "Ray" then
                    args[1] = Ray.new(ray.Origin, (CachedTargetPart.Position - ray.Origin).Unit * 1000)
                    return oldNamecall(self, unpack(args))
                end
            end
        end

        return oldNamecall(self, ...)
    end))
end

getgenv().OllieSB_V2_Cleanup = function()
    Unloaded = true
    if RenderConn then
        pcall(function() RenderConn:Disconnect() end)
    end
    pcall(function() if FOVCircle then FOVCircle:Remove() end end)
    pcall(function() if TargetLine then TargetLine:Remove() end end)
    pcall(function() ScreenGui:Destroy() end)
end
